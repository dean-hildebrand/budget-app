<div id="<%= dom_id transaction %>" class="card card__body">
  <h2><%= transaction.name.capitalize %></h2>

  <p class="stat-card__value numeric amount--<%= transaction.transaction_type %>">
    <%= transaction.expense? ? "−" : "+" %><%= number_to_currency(transaction.amount) %>
  </p>

  <p class="form-hint">
    <span class="badge badge--<%= transaction.transaction_type %>"><%= transaction.transaction_type.capitalize %></span>
    Due <%= transaction.formatted_due_date %>
  </p>
</div>
