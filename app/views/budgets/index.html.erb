<% content_for :title, "Budgets" %>

<div class="page-header">
  <div>
    <span class="page-header__eyebrow">Overview</span>
    <h1>Budgets</h1>
  </div>
</div>

<% if @budgets.any? %>
  <ul id="budgets" class="card-grid">
    <%= render @budgets %>
  </ul>
<% else %>
  <div class="empty-state">
    <h2 class="empty-state__title">No budgets yet</h2>
    <p class="empty-state__text">Start a budget for a month, then add the income and expenses you expect.</p>
    <%= link_to "Create your first budget", new_budget_path, class: "btn btn--primary" %>
  </div>
<% end %>
