<%# Pass `popover: true` to render this form as an anchored popover panel. %>
<% popover = local_assigns.fetch(:popover, false) %>

<%= form_with(model: budget,
      id: dom_id(budget),
      class: class_names("card", "card--form", "popover" => popover),
      html: popover ? { popover: "auto" } : {}) do |form| %>
  <% if budget.errors.any? %>
    <div class="form-errors">
      <h2 class="form-errors__title"><%= pluralize(budget.errors.count, "error") %> prohibited this budget from being saved:</h2>

      <ul class="form-errors__list">
        <% budget.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :month, class: "form-label" %>
    <div class="form-select-group">
      <%= form.date_select :month, { discard_day: true, order: [ :month, :year ], start_year: Date.today.year - 1 } %>
    </div>
    <p class="form-hint">Budgets are tracked one month at a time.</p>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn--primary" %>
    <% if popover %>
      <button type="button" commandfor="<%= dom_id(budget) %>" command="hide-popover" class="btn btn--ghost">Cancel</button>
    <% end %>
  </div>
<% end %>
