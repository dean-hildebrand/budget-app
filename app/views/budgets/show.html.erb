<% content_for :title, "#{@budget.formatted_month} Budget" %>

<% new_transaction = Transaction.new %>

<%= link_to "← Back to budgets", budgets_path, class: "back-link" %>

<div class="page-header">
  <h1><%= @budget.formatted_month %> Budget</h1>

  <div class="page-header__actions">
    <button type="button" commandfor="<%= dom_id(new_transaction, :popover) %>" command="toggle-popover" class="btn btn--primary">Add transaction</button>
    <%= render "transactions/form", budget: @budget, transaction: new_transaction, popover: true %>

    <button type="button" commandfor="<%= dom_id(@budget) %>" command="toggle-popover" class="btn btn--secondary">Edit budget</button>
    <%= render "form", budget: @budget, popover: true %>
    <%= button_to "Delete budget", @budget,
          method: :delete,
          class: "btn btn--danger",
          form_class: "button-to",
          data: { turbo_confirm: "Are you sure? This deletes the budget and its transactions." } %>
  </div>
</div>

<% balance = @budget.remaining_balance %>

<div class="stat-grid">
  <div class="stat-card">
    <span class="stat-card__label">Total income</span>
    <span class="stat-card__value numeric amount--income"><%= number_to_currency(@budget.total_income) %></span>
  </div>

  <div class="stat-card">
    <span class="stat-card__label">Total expenses</span>
    <span class="stat-card__value numeric amount--expense"><%= number_to_currency(@budget.total_expenses) %></span>
  </div>

  <div class="stat-card">
    <span class="stat-card__label">Remaining balance</span>
    <span class="stat-card__value numeric <%= balance.negative? ? "amount--expense" : "amount--balance" %>">
      <%= number_to_currency(balance) %>
    </span>
  </div>
</div>

<% if @budget.transactions.any? %>
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="table__amount">Amount</th>
          <th>Due date</th>
          <th>Type</th>
          <th class="table__actions">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @budget.transactions.each do |transaction| %>
          <tr id="<%= dom_id transaction %>">
            <td class="table__name"><%= transaction.name.capitalize %></td>
            <td class="table__amount numeric amount--<%= transaction.transaction_type %>">
              <%= transaction.expense? ? "-" : "+" %><%= number_to_currency(transaction.amount) %>
            </td>
            <td><%= transaction.formatted_due_date %></td>
            <td>
              <span class="badge badge--<%= transaction.transaction_type %>">
                <%= transaction.transaction_type.capitalize %>
              </span>
            </td>
            <td class="table__actions">
              <div class="actions actions--end">
                <button type="button" commandfor="<%= dom_id(transaction, :popover) %>" command="toggle-popover" class="btn btn--ghost btn--sm">Edit</button>
                <%= render "transactions/form", budget: @budget, transaction: transaction, popover: true %>

                <%= button_to "Delete", budget_transaction_path(@budget, transaction),
                      method: :delete,
                      class: "btn btn--danger btn--sm",
                      form_class: "button-to",
                      data: { turbo_confirm: "Are you sure?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <h2 class="empty-state__title">Nothing budgeted yet</h2>
    <p class="empty-state__text">Add your income and expenses for <%= @budget.formatted_month %> to see where the month lands.</p>
    <button type="button" commandfor="<%= dom_id(new_transaction, :popover) %>" command="toggle-popover" class="btn btn--primary">Add a transaction</button>
  </div>
<% end %>
